# ============================================================
# Python package
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# Sans slash final : le `work-loop` travaille en WORKTREE, et la façon normale d'y avoir un venv est de
# SYMLINKER celui du dépôt principal. Un motif `.venv/` ne matche que des répertoires — le symlink passait
# donc à travers, et un `git add -A` aurait versionné un lien vers un chemin absolu personnel.
.venv
venv
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ============================================================
# Cache local éventuel (sous <repo>/.taskmap/) — reconstructible → JAMAIS versionné.
# NB : à P0 taskmap lit en live (pas d'index dérivé) ; on ancre le motif au cas où un cache apparaisse.
# ============================================================
.taskmap/

# ============================================================
# Index docs-map (sous <repo>/.docsmap/) — carte de doc dérivée, bâtie par `docsmap build`
#   sur docs/**/*.md (dont les runbooks) → reconstructible, JAMAIS versionné.
# ============================================================
.docsmap/

# ============================================================
# Index code-map (sous <repo>/.codemap/) — carte de code dérivée, bâtie par `codemap build`
#   sur src/** → reconstructible, JAMAIS versionné (même doctrine que .docsmap/).
# ============================================================
.codemap/

# ============================================================
# Claude — bundle committé (CLAUDE.md + .claude/) ; état LOCAL ignoré
# ============================================================
.claude/settings.local.json
.claude/*.local.json

# ============================================================
# Env / éditeurs / OS
# ============================================================
.env
.env.*
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
