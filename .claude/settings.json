{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Tool Builder",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.py\" || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip install:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(taskmap:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git rev-parse:*)",
      "Bash(sha256sum:*)",
      "Bash(wc:*)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:docs.pytest.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:mypy.readthedocs.io)"
    ]
  }
}
